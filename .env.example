# Copie para .env.local e preencha. NUNCA versione o .env.local.

# URL pública do site (links de e-mail e cookies de sessão)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Postgres (local via docker compose, ou Neon/Railway/qualquer Postgres 14+)
DATABASE_URL=postgresql://leoes:leoes@localhost:5432/leoes

# Segredo das sessões — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mails transacionais (confirmação de cadastro e recuperação de senha) — opcional
# Sem eles, a confirmação de e-mail fica desativada e, em desenvolvimento,
# os links aparecem no terminal do servidor.
RESEND_API_KEY=
EMAIL_FROM="Leões Gym C5 <nao-responda@seudominio.com.br>"

# Fotos e vídeos enviados pelo painel (Vercel Blob) — opcional.
# Criada automaticamente ao conectar um Blob Store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=

# Inteligência artificial (Etapa 6) — somente servidor
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Só para chaves sem workspace (sk-ant-usr-…): ID do workspace (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Modelo (vazio = padrão claude-opus-5-5)
AI_MODEL=
# low | medium | high — menor = mais rápido e barato
AI_EFFORT=medium
AI_DAILY_LIMIT_PER_USER=10

# Segurança — multiplica apenas os limites de tentativas por IP (padrão 1).
# Use valores altos só em testes automatizados.
RATE_LIMIT_IP_MULTIPLIER=1
