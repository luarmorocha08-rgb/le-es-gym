# Copie para .env.local e preencha. NUNCA versione o .env.local.

# URL pública do site (usada nos links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). Projetos antigos: use a "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor (Etapa 6): chave secreta (sb_secret_... / service_role).
# Usada para registrar gerações de IA. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Inteligência artificial (Etapa 6) — somente servidor
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Identificador do modelo (consulte a documentação do provedor)
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=10
