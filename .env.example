# Copie para .env.local e preencha. NUNCA versione o .env.local.

# URL pública do site (links de e-mail e cookies de sessão)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Postgres (local via docker compose, ou Neon/Railway/qualquer Postgres 14+)
DATABASE_URL=postgresql://leoes:leoes@localhost:5432/leoes

# Segredo das sessões — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mails transacionais (confirmação de cadastro e recuperação de senha) — opcional
# Sem eles, a confirmação de e-mail fica desativada e, em desenvolvimento,
# os links aparecem no terminal do servidor.
RESEND_API_KEY=
EMAIL_FROM="Leões Gym C5 <nao-responda@seudominio.com.br>"

# Inteligência artificial (Etapa 6) — somente servidor
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Identificador do modelo (consulte a documentação do provedor)
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=10
